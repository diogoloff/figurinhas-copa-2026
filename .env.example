FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=troque-por-uma-chave-grande-e-aleatoria

# Formato:
# postgresql+psycopg://USUARIO:SENHA@IP:PORTA/NOME_DO_BANCO
# Se a senha tiver @, #, %, / etc, codifique os caracteres especiais.
# Exemplo: Minha@Senha#123 vira Minha%40Senha%23123
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/fwc_26
POSTGRES_SCHEMA=app

# Gmail SMTP. Use uma senha de app do Google, nao a senha normal da conta.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-de-app-do-gmail
MAIL_DEFAULT_SENDER=seu-email@gmail.com

# Dominio usado para gerar links nos emails em ambiente fora do request.
APP_BASE_URL=http://localhost:5000

# Desenvolvimento pode usar memory://. Para producao, prefira Redis, Memcached ou outro storage suportado pelo Flask-Limiter.
RATELIMIT_STORAGE_URI=memory://
