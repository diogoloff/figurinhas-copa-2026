FLASK_APP=run.py
FLASK_DEBUG=0
SECRET_KEY=troque-por-uma-chave-grande-e-aleatoria

# Formato:
# postgresql+psycopg://USUARIO:SENHA@IP:PORTA/NOME_DO_BANCO
# Se a senha tiver @, #, %, / etc, codifique os caracteres especiais.
# Exemplo: Minha@Senha#123 vira Minha%40Senha%23123
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/fwc_26
POSTGRES_SCHEMA=app

# Gmail SMTP. Use uma senha de app do Google, nao a senha normal da conta.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-de-app-do-gmail
MAIL_DEFAULT_SENDER=seu-email@gmail.com

# Dominio usado para gerar links nos emails em ambiente fora do request.
APP_BASE_URL=https://seudominio.com.br

# Hosts aceitos pela aplicacao. Separe por virgula.
TRUSTED_HOSTS=seudominio.com.br,www.seudominio.com.br

# Ative quando publicar com HTTPS.
SESSION_COOKIE_SECURE=true

# Se estiver atras de Nginx/Caddy/Traefik, confie em exatamente 1 proxy.
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
PROXY_FIX_X_HOST=1

# Tamanho maximo do corpo da requisicao, em bytes.
MAX_CONTENT_LENGTH=1048576

# Desenvolvimento pode usar memory://. Em producao, use Redis ou outro storage compartilhado suportado pelo Flask-Limiter.
RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
RATELIMIT_DEFAULT=200 per minute; 2000 per hour
